/target
**/*.rs.bk
.DS_Store
Thumbs.db
*.staffcrop
*.staffcrop.files/
*.staffcrop.cache/

**/.tmp*

# ffmpeg / pdfium / 底色图片 不随源码提交 (太大/有各自的版权分发限制): 打包发行版时
# 把 vendor/ 下这两份手动拷到 exe 同目录即可, 程序会优先找同目录的那份,
# 找不到再退回系统 PATH.
/vendor/
ffmpeg.exe
pdfium.dll

**/target/

# 工作区 crate 若单独 cargo 过会产生 lock; 主工程只用根 Cargo.lock
crates/**/Cargo.lock

# 图标源稿/预览脚本只留本地; 嵌入 Windows 的只有 ico 和 rc
/assets/*
!/assets/app.ico
!/assets/app.rc

# PyInstaller
/dist/
/build/
*.spec
/tools/dist/
/tools/build/
**/__pycache__/

